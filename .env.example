# Salin ke .env lalu jalankan `make up`. File .env tidak boleh di-commit.
#
# Semua nilai di bawah SUDAH BERFUNGSI untuk stack mock (seluruh sumber adalah
# API tiruan berisi data sintetis), jadi clone baru bisa langsung jalan tanpa
# mengubah apa pun. Ganti nilainya bila stack dipakai di lingkungan bersama.

# --- Sumber Angkasa Biru Retail (Rinjani, mock) ---
# live = tarik dari API mock. sample = pakai fixture data/sample/<sumber> (dev/test offline).
ANGKASABIRURETAIL_SOURCE_MODE=live
ANGKASABIRURETAIL_API_BASE_URL=http://mock-angkasabiruretail:8000/api
# API key bebas: nilai yang sama diberikan ke instance mock, jadi selalu cocok.
ANGKASABIRURETAIL_API_KEY=mock-api-key
# Opsional: ANGKASABIRURETAIL_SESSION_COOKIE (kosong/tidak diisi = tanpa cookie).

# --- Sumber Angkasa Biru (SAPATH, mock) ---
ANGKASABIRU_SOURCE_MODE=live
ANGKASABIRU_API_BASE_URL=http://mock-angkasabiru:8000/api/portalhc/v1
# Username/password bebas: nilai yang sama diberikan ke instance mock.
ANGKASABIRU_API_USERNAME=mock-user
ANGKASABIRU_API_PASSWORD=mock-password

# --- Sumber Angkasa Biru Destination (NATA RINJANI, mock) ---
ABDESTINATION_SOURCE_MODE=live
ABDESTINATION_API_BASE_URL=http://mock-abdestination:8000/api/v1
ABDESTINATION_API_TOKEN=mock-token

# --- Sumber Angkasa Biru LMS (learning agility, mock) ---
LMS_SOURCE_MODE=live
LMS_API_BASE_URL=http://mock-lms:8000/api
LMS_API_KEY=mock-lms-key

# --- MinIO (arsip raw) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_RAW_BUCKET=angkasabiruretail-raw

# --- Postgres DWH (warehouse antara) ---
DWH_DB=angkasabiru_dwh
DWH_USER=dwh
DWH_PASSWORD=dwh_dev_password
# --- Postgres Data Hub (target akhir) ---
DATAHUB_DB=angkasabiru_datahub
DATAHUB_USER=datahub
DATAHUB_PASSWORD=datahub_dev_password

# --- Airflow ---
AIRFLOW_DB_PASSWORD=airflow_dev_password
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_UID=50000

# --- Metabase (visualisasi) ---
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Metabase_dev_123
METABASE_DB_PASSWORD=metabase_dev_password
METABASE_RO_USER=metabase_ro      # role read-only ke Data Hub (marts + meta)
METABASE_RO_PASSWORD=metabase_ro_dev

# Zona waktu seluruh container (default = Asia/Jakarta / WIB)
TZ=Asia/Jakarta

# --- Port akses tiap instance pada mesin host (dipetakan docker-compose.yml; jalankan `make up` setelah mengubah)
# Postgres DWH dan Data Hub. Bila diubah, samakan juga DWH_PORT/DATAHUB_PORT untuk skrip yang
# berjalan dari host (bawaannya 5433/5434); port Metabase ada di blok Metabase (METABASE_PORT).
DWH_HOST_PORT=5433
DATAHUB_HOST_PORT=5434
# Airflow webserver dan MinIO; bila port API MinIO diubah, samakan MINIO_ENDPOINT di atas.
# Postgres metadata Airflow dan Metabase sengaja tidak dibuka ke host.
AIRFLOW_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MOCK_ANGKASABIRU_PORT=8101
MOCK_ANGKASABIRURETAIL_PORT=8102
MOCK_ABDESTINATION_PORT=8103
MOCK_LMS_PORT=8104
